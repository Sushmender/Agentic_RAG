# ========================
# LandingAI ADE
# ========================
LANDINGAI_API_KEY=your_landingai_api_key_here
LANDINGAI_API_URL=https://api.landing.ai/v1/tools/document-analysis
ADE_TIER=verity

# ========================
# OpenRouter (NVIDIA models)
# ========================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
RERANKER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
FALLBACK_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ========================
# Groq (Primary LLM)
# ========================
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_LLM_MODEL=qwen-qwq-32b

# ========================
# Redis (Upstash)
# ========================
REDIS_URL=rediss://default:your_password@your-instance.upstash.io:6379

# ========================
# ChromaDB
# ========================
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=ade_documents

# ========================
# Storage paths
# ========================
UPLOAD_DIR=./data/uploads
ADE_OUTPUT_DIR=./data/ade_outputs

# ========================
# RAG pipeline settings
# ========================
RETRIEVAL_TOP_N=20
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=8000
EMBEDDING_BATCH_SIZE=16

# ========================
# Server settings
# ========================
APP_NAME=Multimodal RAG API
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================
# Auth (JWT)
# ========================
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ========================
# Resilience
# ========================
RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_SECONDS=1
TIMEOUT_SECONDS=30
